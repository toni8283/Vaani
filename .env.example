# Supabase (Public Client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase (Server-only Service Role - NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Demo Mode Simulator (true = offline simulated calls; false = live telephony)
NEXT_PUBLIC_DEMO_MODE=false

# Outbound Call Server (Express + WebSocket bridge)
CALL_SERVER_URL=http://localhost:8080

# Call Server API Secret (Server-only - NEVER expose to browser)
# Sent in x-api-secret header for protected call server routes
CALL_SERVER_SECRET=your_call_server_secret_here

# Browser Call WebSocket Bridge (Public client URL)
# Used by useBrowserCall to stream 24kHz audio directly to/from AssemblyAI via call server
NEXT_PUBLIC_CALL_SERVER_WS_URL=ws://localhost:8080
