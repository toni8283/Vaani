# ─────────────────────────────────────────────────────────────────────────────
# Vaani — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local or any file containing real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Public — safe for the browser) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (Server-only — NEVER expose to the browser) ─────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ── Call Server (Express + WebSocket bridge) ──────────────────────────────────
# HTTP URL used by server-side Next.js API routes to reach the call server
CALL_SERVER_URL=http://localhost:8080

# Shared secret sent in the x-api-secret header (server-only, never browser)
CALL_SERVER_SECRET=

# WebSocket URL used by the browser to stream audio directly to the call server
NEXT_PUBLIC_CALL_SERVER_WS_URL=ws://localhost:8080

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "true" to enable the Twilio phone-call path (not demo-ready).
# Default (empty / false) uses browser calls only.
NEXT_PUBLIC_PHONE_CALLS=
